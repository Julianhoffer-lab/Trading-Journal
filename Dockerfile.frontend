# Node.js als Basis-Image
FROM node:20-alpine

# Arbeitsverzeichnis im Container festlegen
WORKDIR /app

# Package-Dateien kopieren und Abhängigkeiten installieren
COPY frontend/package*.json ./
RUN npm install --legacy-peer-depsdocker compose build --no-cache frontend

# Gesamten Frontend-Code kopieren
COPY frontend/. .

# Vite-Entwicklungsserver ausführen (auf allen Schnittstellen lauschen)
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]